{
  "name": "unidad-central",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "check-types": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test 'pruebas/*.test.ts' 'pruebas/**/*.test.ts'",
    "prueba": "node --import tsx --test 'pruebas/*.test.ts' 'pruebas/**/*.test.ts'",
    "verificar": "node --import tsx scripts/verificar-sistema.ts && npm run check-types && npm test"
  },
  "dependencies": {
    "expo": "~52.0.49",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.21",
    "expo-status-bar": "~2.0.1",
    "firebase": "^12.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "~18.3.12",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.3.3",
    "vite": "^8.2.2"
  },
  "private": true
}
